# Supabase project URL (Settings → API in the Supabase dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key — server-side only, never exposed to the browser.
# All DB writes go through Next.js route handlers, so the anon key is not used.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: absolute origin used to build share links (falls back to the
# request origin at runtime, so this is only needed for OG tags later).
# NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app
